{
"update_url": "https://clients2.google.com/service/update2/crx",

  "manifest_version": 3,
  "name": "WebRTC IP保护",
  "version": "0.0.1",
  "description": "一键禁用WebRTC协议，彻底阻止IP泄露风险，保护隐私安全",
  "author": "qczone",
  "homepage_url": "https://www.example.com/4661",
